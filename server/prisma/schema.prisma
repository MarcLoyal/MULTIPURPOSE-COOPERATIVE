generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase's pgbouncer, port 6543) — used at runtime.
  // Required when running as Vercel serverless functions, where every
  // invocation can open a new connection.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used only for migrations, which need
  // a real session (pgbouncer's transaction pooling mode breaks them).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  cashier
  credit_officer
  manager
  accountant
  admin
}

enum UserStatus {
  active
  disabled
}

enum MemberStatus {
  active
  inactive
  resigned
  deceased
  terminated
}

// Needed before deposits or share classes can be built correctly: common
// shares/regular-member-only deposit rules vs. preferred shares/associate
// eligibility both key off this (report gap-analysis item 3, Q9).
enum MembershipClass {
  regular
  associate
}

enum DepositType {
  savings
  time
}

enum DepositComputationBasis {
  daily_balance
  average_daily_balance
  lowest_monthly_balance
  month_end_balance
}

enum DepositAccountStatus {
  active
  closed
}

enum DepositTxnType {
  deposit
  withdrawal
  interest_credit
  pretermination_penalty
}

enum FiscalYearStatus {
  open
  closed
}

enum ShareCapitalTxnType {
  subscription
  additional_purchase
  withdrawal
  transfer
  dividend
}

enum ShareCapitalTxnStatus {
  pending
  approved
  rejected
  posted
}

enum LoanStatus {
  applied
  under_review
  approved
  released
  active
  past_due
  restructured
  closed
  rejected
}

enum LoanTxnType {
  release
  repayment
  penalty
  restructure
}

enum RatePeriod {
  monthly
  annual
}

// CDA MC 2012-05 Section 4 requires interest charged only on the
// outstanding balance at the start of each period (diminishing balance),
// not flat on the original principal. "flat" is kept only because the
// report found flat/advance-deducted products still exist in practice —
// selecting it for a real product needs a written auditor/CDA sign-off
// per the report (Q22), which this schema can't enforce by itself.
enum LoanComputationMethod {
  diminishing_balance
  flat
}

enum AmortizationStyle {
  equal_payment
  equal_principal
}

enum CashTxnType {
  collection
  disbursement
  petty_cash
  cash_advance
  bank_deposit
}

enum LedgerSourceType {
  share_capital
  loan
  cash
  manual
}

enum AccountElement {
  asset
  liability
  equity
  revenue
  expense
}

enum NormalBalance {
  debit
  credit
}

enum AuditAction {
  create
  update
  approve
  reject
  delete_attempt
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  membersCreated Member[] @relation("MemberCreatedBy")

  @@map("users")
}

model Member {
  id                       String       @id @default(uuid())
  memberNumber             String       @unique @map("member_number")
  fullName                 String       @map("full_name")
  phone                    String?
  email                    String?
  address                  String?
  dateJoined               DateTime     @default(now()) @map("date_joined")
  status                   MemberStatus @default(active)
  // Added for Phase 0 (dormant — no deposit or share-class module reads
  // this yet). Defaults every existing/new member to regular so nothing
  // live changes behavior.
  membershipClass          MembershipClass @default(regular) @map("membership_class")
  beneficiaryName          String?      @map("beneficiary_name")
  beneficiaryRelationship  String?      @map("beneficiary_relationship")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  createdById              String?      @map("created_by")
  createdBy                User?        @relation("MemberCreatedBy", fields: [createdById], references: [id])

  shareCapitalAccount ShareCapitalAccount?
  loanAccounts        LoanAccount[]
  depositAccounts     DepositAccount[]

  @@map("members")
}

model ShareCapitalAccount {
  id        String   @id @default(uuid())
  memberId  String   @unique @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions ShareCapitalTransaction[]

  @@map("share_capital_accounts")
}

model ShareCapitalTransaction {
  id                    String                 @id @default(uuid())
  shareCapitalAccountId String                 @map("share_capital_account_id")
  account               ShareCapitalAccount    @relation(fields: [shareCapitalAccountId], references: [id])
  type                  ShareCapitalTxnType
  amount                Decimal                @db.Decimal(18, 2)
  status                ShareCapitalTxnStatus  @default(pending)
  createdById           String                 @map("created_by")
  approvedById          String?                @map("approved_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  approvedAt            DateTime?              @map("approved_at")

  ledgerEntries LedgerEntry[]

  @@map("share_capital_transactions")
}

// Board-approved loan products (CDA MC 2012-05 / report gap-analysis item
// 2): rate, rate period, computation method and amortization style are
// per-product data, not hard-coded constants, with diminishing balance as
// the default method. A LoanAccount snapshots a product's terms at
// application time (see LoanAccount.computationMethod) so a later edit to
// the product doesn't retroactively change an existing loan's contract.
model LoanProduct {
  id                String                 @id @default(uuid())
  name              String                 @unique
  description       String?
  interestRate      Decimal                @db.Decimal(7, 4) @map("interest_rate")
  ratePeriod        RatePeriod             @default(monthly) @map("rate_period")
  computationMethod LoanComputationMethod  @default(diminishing_balance) @map("computation_method")
  amortizationStyle AmortizationStyle      @default(equal_payment) @map("amortization_style")
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  loanAccounts LoanAccount[]

  @@map("loan_products")
}

model LoanAccount {
  id             String     @id @default(uuid())
  memberId       String     @map("member_id")
  member         Member     @relation(fields: [memberId], references: [id])
  loanProduct    String     @map("loan_product")
  loanProductId  String?    @map("loan_product_id")
  product        LoanProduct? @relation(fields: [loanProductId], references: [id])
  principalAmount Decimal   @db.Decimal(18, 2) @map("principal_amount")
  interestRate   Decimal    @db.Decimal(7, 4) @map("interest_rate")
  // Snapshotted from the product (or defaulted) at application time —
  // diminishing balance by default per CDA MC 2012-05 Section 4, not a
  // hard-coded formula. See report gap-analysis item 2.
  computationMethod LoanComputationMethod @default(diminishing_balance) @map("computation_method")
  termMonths     Int        @map("term_months")
  status         LoanStatus @default(applied)
  reviewNotes    String?    @map("review_notes")
  releaseDate    DateTime?  @map("release_date")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  transactions LoanTransaction[]

  @@map("loan_accounts")
}

model LoanTransaction {
  id            String      @id @default(uuid())
  loanAccountId String      @map("loan_account_id")
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])
  type          LoanTxnType
  amount        Decimal     @db.Decimal(18, 2)
  balanceAfter  Decimal     @db.Decimal(18, 2) @map("balance_after")
  createdById   String      @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]
  cashTransactions CashTransaction[]

  @@map("loan_transactions")
}

model CashTransaction {
  id                    String      @id @default(uuid())
  type                  CashTxnType
  amount                Decimal     @db.Decimal(18, 2)
  referenceType         String?     @map("reference_type")
  loanTransactionId     String?     @map("loan_transaction_id")
  loanTransaction       LoanTransaction? @relation(fields: [loanTransactionId], references: [id])
  shareCapitalTransactionId String? @map("share_capital_transaction_id")
  officialReceiptNumber String      @map("official_receipt_number")
  createdById           String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]

  @@map("cash_transactions")
}

// CDA MC 2022-24 "Revised Standard Chart of Accounts for Cooperatives" —
// see docs/research (Philippine_cooperative_system_rules.md) for sourcing.
// Seeded by migration 20261005_chart_of_accounts_mc2022_24, not by seed.ts,
// so the chart is guaranteed present in every environment (dev, staging,
// Supabase) without depending on someone running `npm run seed`.
model Account {
  code         String         @id
  label        String
  element      AccountElement
  normalBalance NormalBalance @map("normal_balance")
  isContra     Boolean        @default(false) @map("is_contra")
  isActive     Boolean        @default(true) @map("is_active")
  // TODO(needs-review): true for codes the research report flagged as
  // needing a human to read the primary MC 2022-24 PDF before they're
  // trusted (e.g. 30600's dual Net Surplus/Net Loss use, 18100/18200's
  // heading placement) and for the two codes this app invented because
  // the report's curated table has no generic other-income/other-expense
  // line item at all. See reviewNote for the specific open question.
  needsReview  Boolean        @default(false) @map("needs_review")
  reviewNote   String?        @map("review_note")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@map("accounts")
}

model LedgerEntry {
  id         String           @id @default(uuid())
  entryDate  DateTime         @default(now()) @map("entry_date")
  accountCode String          @map("account_code")
  account    Account          @relation(fields: [accountCode], references: [code])
  debit      Decimal          @default(0) @db.Decimal(18, 2)
  credit     Decimal          @default(0) @db.Decimal(18, 2)
  sourceType LedgerSourceType @map("source_type")

  shareCapitalTransactionId String?                  @map("share_capital_transaction_id")
  shareCapitalTransaction   ShareCapitalTransaction? @relation(fields: [shareCapitalTransactionId], references: [id])
  loanTransactionId         String?                  @map("loan_transaction_id")
  loanTransaction           LoanTransaction?         @relation(fields: [loanTransactionId], references: [id])
  cashTransactionId         String?                  @map("cash_transaction_id")
  cashTransaction           CashTransaction?         @relation(fields: [cashTransactionId], references: [id])

  batchId    String   @map("batch_id")
  memo       String?
  createdById String  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Phase 0 scaffolding — deposits, statutory funds, fiscal years.
//
// Schema only. Nothing in server/src imports or routes to these models;
// no UI reads or writes them. They exist so the data shape is in place
// ahead of time, per report gap-analysis items 3 and 4, but every one of
// these features needs cooperative-specific answers (does it even offer
// deposits? what are the bylaws' fund percentages? etc. — report
// Q7-Q15, Q36-Q45) before it can be switched on. Do not wire routes or
// UI to these without that.
// ---------------------------------------------------------------------------

// Savings and time deposits are liabilities, legally and in the mandatory
// chart of accounts (21110/21120/21130) — a separate product from share
// capital (equity), not a view onto ShareCapitalAccount. Report
// gap-analysis item 3.
model DepositProduct {
  id                       String                   @id @default(uuid())
  name                     String                   @unique
  type                     DepositType
  interestRate             Decimal                  @db.Decimal(7, 4) @map("interest_rate")
  computationBasis         DepositComputationBasis  @default(month_end_balance) @map("computation_basis")
  creditingFrequencyMonths Int                      @default(1) @map("crediting_frequency_months")
  minimumBalance           Decimal                  @default(0) @db.Decimal(18, 2) @map("minimum_balance")
  // Time deposits only; null for savings.
  termMonths               Int?                     @map("term_months")
  preTerminationPenaltyRate Decimal?                @db.Decimal(7, 4) @map("pre_termination_penalty_rate")
  isActive                 Boolean                  @default(true) @map("is_active")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  depositAccounts DepositAccount[]

  @@map("deposit_products")
}

model DepositAccount {
  id               String                @id @default(uuid())
  memberId         String                @map("member_id")
  member           Member                @relation(fields: [memberId], references: [id])
  depositProductId String                @map("deposit_product_id")
  depositProduct   DepositProduct        @relation(fields: [depositProductId], references: [id])
  balance          Decimal               @default(0) @db.Decimal(18, 2)
  status           DepositAccountStatus  @default(active)
  openedAt         DateTime              @default(now()) @map("opened_at")
  closedAt         DateTime?             @map("closed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  transactions DepositTransaction[]

  @@map("deposit_accounts")
}

model DepositTransaction {
  id               String         @id @default(uuid())
  depositAccountId String         @map("deposit_account_id")
  depositAccount   DepositAccount @relation(fields: [depositAccountId], references: [id])
  type             DepositTxnType
  amount           Decimal        @db.Decimal(18, 2)
  balanceAfter     Decimal        @db.Decimal(18, 2) @map("balance_after")
  createdById      String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("deposit_transactions")
}

// Net surplus must fund four statutory funds within RA 9520 Art. 86 bounds
// before anything reaches members as interest on share capital or
// patronage refund (report gap-analysis item 4). The actual percentages
// are bylaws-set, never hard-coded; the Art. 86 bounds themselves are
// enforced as DB CHECK constraints (see migration) rather than as
// validation this app can silently skip.
model FiscalYear {
  id          String           @id @default(uuid())
  yearEndDate DateTime         @map("year_end_date")
  status      FiscalYearStatus @default(open)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  statutoryFundAllocation StatutoryFundAllocation?

  @@map("fiscal_years")
}

model StatutoryFundAllocation {
  id                       String     @id @default(uuid())
  fiscalYearId             String     @unique @map("fiscal_year_id")
  fiscalYear               FiscalYear @relation(fields: [fiscalYearId], references: [id])
  // Art. 86 bound: >= 10% (>= 50% in the cooperative's first five years —
  // that conditional floor isn't expressible as a static CHECK constraint
  // and is intentionally left for Phase 5's allocation engine).
  reserveFundPercent       Decimal    @db.Decimal(5, 2) @map("reserve_fund_percent")
  // Art. 86 bound: <= 10% total, split 50/50 internal/union-federation.
  cetfPercent              Decimal    @db.Decimal(5, 2) @map("cetf_percent")
  // Art. 86 bound: >= 3%, no statutory ceiling.
  communityDevFundPercent  Decimal    @db.Decimal(5, 2) @map("community_dev_fund_percent")
  // Art. 86 bound: <= 7%.
  optionalFundPercent      Decimal    @db.Decimal(5, 2) @map("optional_fund_percent")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  @@map("statutory_fund_allocations")
}

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id")
  action        AuditAction
  previousValue Json?       @map("previous_value")
  newValue      Json?       @map("new_value")
  performedById String      @map("performed_by")
  performedByName String    @map("performed_by_name")
  performedAt   DateTime    @default(now()) @map("performed_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}
