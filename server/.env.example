# Local dev (docker-compose / local Postgres) — same URL for both:
DATABASE_URL="postgresql://coop:coop_dev_password@localhost:5432/coop_mvp?schema=public"
DIRECT_URL="postgresql://coop:coop_dev_password@localhost:5432/coop_mvp?schema=public"

# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL = "Transaction" pooler connection (port 6543) + &pgbouncer=true
#     e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=10
#   DIRECT_URL   = "Session" pooler connection (port 5432) — IPv4-reachable,
#     used for migrations; the true direct connection (db.<ref>.supabase.co)
#     is IPv6-only and unreachable from most CI/serverless networks
#     e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=10
#
#   connect_timeout (seconds) bounds how long Prisma will wait to establish
#   a connection before failing with a clear error, on every query (not
#   just the health check) — without it, a bad host/port/network ACL hangs
#   until something external (Vercel's function timeout) kills it, which
#   looks like "never responds" instead of a diagnosable error. Set this on
#   the real values in Vercel's env vars too, not just here.

JWT_SECRET="change-this-dev-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
