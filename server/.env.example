# Local dev (docker-compose / local Postgres) — same URL for both:
DATABASE_URL="postgresql://coop:coop_dev_password@localhost:5432/coop_mvp?schema=public"
DIRECT_URL="postgresql://coop:coop_dev_password@localhost:5432/coop_mvp?schema=public"

# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL = "Transaction" pooler connection (port 6543) + &pgbouncer=true
#     e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct connection (port 5432), used only for migrations
#     e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

JWT_SECRET="change-this-dev-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
