# Leave unset for local dev — Vite proxies /api to http://localhost:4000
# (see vite.config.ts). Set this in Vercel's project env vars (Production
# scope) to the deployed backend's URL, e.g. https://coop-mvp-server.vercel.app
VITE_API_URL=

# Set once in Vercel (Preview scope only, not Production) to the server
# project's own preview URL pattern, with a literal "{branch}" placeholder
# where the branch name goes — copy the exact pattern from any real server
# preview deployment's URL, e.g.:
#   https://multipurpose-cooperative-server-git-{branch}-<your-team-slug>.vercel.app
# vite.config.ts fills in {branch} at build time from Vercel's own
# VERCEL_GIT_COMMIT_REF, so every PR's client preview automatically calls
# that same PR's server preview — no per-PR configuration needed. See
# server/.env.example's CLIENT_PREVIEW_ORIGIN_TEMPLATE for the matching
# CORS allowlist entry this depends on.
VITE_PREVIEW_SERVER_URL_TEMPLATE=
